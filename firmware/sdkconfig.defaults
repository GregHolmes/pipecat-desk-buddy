CONFIG_IDF_TARGET="esp32s3"

# Faster Flashing
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Enable PSRAM
CONFIG_SPIRAM=y

# Performance
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Enable DTLS
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y

# Defaults to partitions.csv
CONFIG_PARTITION_TABLE_CUSTOM=y

# libpeer requires large stack allocations
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# libpeer reads one packet per loop; give bursts room
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# Camera: keep its high-priority task off core 0 (WebRTC + Wi-Fi) and DMA
# frames straight into PSRAM instead of copying them with the CPU.
CONFIG_CAMERA_CORE1=y
# CONFIG_CAMERA_PSRAM_DMA is not set
